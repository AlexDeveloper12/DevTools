@using DevTools.UI.Client.Helpers
<div class="row">
    <div class="col-md-12 d-flex align-items-center gap-2">
        <div
            class="d-flex justify-content-center align-items-center w-100 password-strength-container 
@StrengthBgColourClass">
        </div>
        <span class="@StrengthColourClass">@StrengthText</span>
        <i class="@StrengthIcon"></i>

    </div>
</div>

@code{

    [Parameter, EditorRequired] public int StrengthScore { get; set; }
    [Parameter, EditorRequired] public string? PasswordText { get; set; }

    [PersistentState] public string? StrengthBgColourClass { get; set; }
    [PersistentState] public string? StrengthColourClass { get; set; }
    [PersistentState] public string? StrengthIcon { get; set; }
    [PersistentState] public string? StrengthText { get; set; }

    private int _strengthScore;

    protected override void OnParametersSet()
    {
        CalculatePasswordStrength();
    }

    private void CalculatePasswordStrength()
    {
        if (PasswordText is null) return;
        _strengthScore = 0;

        var containsUpper = PasswordGeneratorLists.Alphabet.Any(x => PasswordText.Contains(x.ToUpper()));
        var containsLower = PasswordGeneratorLists.Alphabet.Any(x => PasswordText.Contains(x));
        var containsNumbers = PasswordGeneratorLists.Numbers.Any(x => PasswordText.Contains(x.ToString()));
        var containsSymbols = PasswordGeneratorLists.Symbols.Any(x => PasswordText.Contains(x));

        if (PasswordText.Length < 8) _strengthScore = 0;
        else
        {
            if (PasswordText.Length >= 8) _strengthScore += 1;

            if (PasswordText.Length > 12) _strengthScore += 1;

            if (containsUpper) _strengthScore += 1;

            if (containsLower) _strengthScore += 1;

            if (containsSymbols) _strengthScore += 2;

            if (containsNumbers) _strengthScore += 1;
        }
        
        DetermineStrengthColour(_strengthScore);
    }
    
    private void DetermineStrengthColour(int? score)
    {
        switch (score)
        {
            case <= 2:
                StrengthBgColourClass = "weak-password";
                StrengthColourClass = "weak-color";
                StrengthIcon = "fa-solid fa-xmark";
                StrengthText = "Weak";
                break;
            case > 2 and <= 4:
            case > 4 and <= 6:
                StrengthBgColourClass = "average-password";
                StrengthColourClass = "average-color";
                StrengthIcon = "fa-solid fa-triangle-exclamation";
                StrengthText = "Average";
                break;
            default:
                StrengthBgColourClass = "strong-password";
                StrengthColourClass = "strong-color";
                StrengthIcon = "fa-solid fa-check";
                StrengthText = "Strong";
                break;
        }
    }

}