
<div class="row justify-content-center align-items-center mt-2">
    <div class="col-md-5">
        <input type="text" class="form-control p-2" value="@PasswordText" @bind:event="oninput" minlength="1"
               maxlength="20"/>
    </div>
    <div class="col-md-1">
        <button
            type="button"
            class="btn btn-link"
            @onclick="GeneratePassword"
            title="Generate Password">
            <i class="fa-solid fa-arrows-rotate generate-password-icon"></i>
        </button>
    </div>
</div>

@code {
    
    [Parameter]
    public string PasswordText { get; set; }
    
    [Parameter]
    public EventCallback<string> PasswordTextChanged { get; set; }
    
    [Parameter]
    public EventCallback OnGeneratePassword { get; set; }
    
    private async Task GeneratePassword()
    {
        await OnGeneratePassword.InvokeAsync();
    }
}