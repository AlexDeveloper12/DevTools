
<div class="row justify-content-center mt-2">
    <div class="col-md-5">
        <input type="text" class="form-control p-2" value="@PasswordText" @bind:event="oninput" minlength="1"
               maxlength="20"/>
    </div>
</div>

@code {
    
    [Parameter]
    public string PasswordText { get; set; }
    
    [Parameter]
    public EventCallback<string> PasswordTextChanged { get; set; }
}