@page "/password-generator"
@using DevTools.UI.Client.Components.PasswordGenerator
@using DevTools.UI.Client.Helpers
@rendermode InteractiveWebAssembly

<div class="d-flex justify-content-center">
    <h3>Password Generator</h3>
</div>

<div class="card mt-2 p-1">
    <div class="card-body">

        <PasswordInput
            @bind-PasswordText="PasswordText"
            OnGeneratePassword="GeneratePassword"
        />

        <div class="row justify-content-center mt-2">
            <div class="col-md-6">
                <input type="range" class="form-range"
                       min="@min"
                       max="@max"
                       @bind="passwordLength"
                       @bind:event="oninput"
                       id="passwordLength"/>

                <p>Password Length: @passwordLength</p>
            </div>
        </div>

        <!--password strength meter-->

        <PasswordStrengthDisplay
            PasswordText="@PasswordText"
            StrengthScore="@StrengthScore"/>

        <div class="row mt-4">
            <div class="col-md-12">
                <ul class="list-group list-group-horizontal justify-content-center">
                    <li class="list-group-item">
                        <label>
                            Options Used
                        </label>

                    </li>
                    <ListItemCheckbox
                        Id="cbUppercase"
                        Text="Uppercase"
                        @bind-IsOption="IsUppercase"/>

                    <ListItemCheckbox
                        Id="cbLowercase"
                        Text="Lowercase"
                        @bind-IsOption="IsLowercase"
                    />


                    <ListItemCheckbox
                        Id="cbNumbers"
                        Text="Numbers"
                        @bind-IsOption="IsNumbers"
                    />

                    <ListItemCheckbox
                        Id="cbSymbols"
                        Text="Symbols"
                        @bind-IsOption="IsSymbols"/>


                </ul>
            </div>
        </div>
    </div>
</div>

@if (IsInvalidOptions)
{
    <GenericAlert
        @bind-IsVisible="IsInvalidOptions"
        Message="@invalidOptionsMessage"
        Type="@alertWarning"
    />
}

@code {

    private int min = 1;
    private int max = 20;
    private int passwordLength = 8;
    private string alertWarning = "warning";
    private string invalidOptionsMessage = "Please select at least one option.";

    [PersistentState] public string? PasswordText { get; set; }
    [PersistentState] public int StrengthScore { get; set; } = 0;

    private bool IsUppercase { get; set; } = true;
    private bool IsLowercase { get; set; } = true;
    private bool IsNumbers { get; set; } = true;
    private bool IsSymbols { get; set; } = true;

    private bool IsInvalidOptions { get; set; } = false;

    protected override void OnInitialized()
    {
        if (PasswordText is null)
        {
            GeneratePassword();
        }
    }

    private void GeneratePassword()
    {
        if (!IsUppercase && !IsLowercase && !IsNumbers && !IsSymbols)
        {
            IsInvalidOptions = true;
            return;
        }

        PasswordText = string.Empty;
        var random = new Random();

        while (PasswordText.Length < passwordLength)
        {
            IsInvalidOptions = false;

            if (IsUppercase)
            {
                var index = random.Next(0, PasswordGeneratorLists.Alphabet.Count);
                PasswordText += PasswordGeneratorLists.Alphabet[index].ToUpper();
                if (PasswordText.Length >= passwordLength) break;
            }

            if (IsLowercase)
            {
                var index = random.Next(0, PasswordGeneratorLists.Alphabet.Count);
                PasswordText += PasswordGeneratorLists.Alphabet[index].ToLower();
                if (PasswordText.Length >= passwordLength) break;
            }

            if (IsNumbers)
            {
                var index = random.Next(0, PasswordGeneratorLists.Numbers.Count);
                PasswordText += PasswordGeneratorLists.Numbers[index].ToString();
                if (PasswordText.Length >= passwordLength) break;
            }

            if (IsSymbols)
            {
                var index = random.Next(0, PasswordGeneratorLists.Symbols.Count);
                PasswordText += PasswordGeneratorLists.Symbols[index];
                if (PasswordText.Length >= passwordLength) break;
            }
        }
    }

}